# Copy this file to .env and fill it in yourself. Never paste tokens in chat.
# See docs/SETUP.md for how to get each value.

# One of these two is required.
# Long-lived user token or System User token (recommended: covers all your Pages).
FB_USER_ACCESS_TOKEN=
# Or a single Page token + its Page id.
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Optional: Page ids (comma-separated) to always list, e.g. Pages owned by a Business Portfolio
# that Facebook leaves out of your Page list. Not secret.
FB_EXTRA_PAGE_IDS=

# Recommended: turns on appsecret_proof so a leaked token alone is not enough.
FB_APP_SECRET=
# App ID (not secret). Used by `npm run login`; filled in automatically if blank.
FB_APP_ID=

# Safety switch. Keep false until you have tested reads. true = Claude may post, reply, delete, message.
FB_WRITE_ENABLED=false

# Tunables (default, min-max). Leave blank to use the default.
FB_GRAPH_VERSION=           # v26.0
FB_READ_RATE_PER_MIN=       # 120 (1-600)
FB_WRITE_RATE_PER_MIN=      # 10 (1-60)
FB_HTTP_TIMEOUT_MS=         # 15000 (1000-60000)
FB_IDEMPOTENCY_TTL_MIN=     # 1440 (1-10080)
FB_MAX_LIST_LIMIT=          # 100 (1-100)
FB_SCHEDULE_MIN_MINUTES=    # 10 (10-1440)
FB_SCHEDULE_MAX_DAYS=       # 30 (1-75)
FB_MAX_UPLOAD_MB=           # 10 (1-100)
FB_LEADS_SCAN_MAX=          # 200 (1-2000) conversations or comments scanned per lead search
FB_LEADS_MESSAGES_PER_CHAT= # 25 (1-100) newest messages read per conversation
FB_LEADS_SCAN_POSTS=        # 25 (1-100) newest posts scanned for comment leads
FB_LEADS_CHATS_PER_PAGE=    # 25 (1-100) conversations fetched per request in Messenger lead search
FB_PAGES_REFRESH_COOLDOWN_SEC= # 60 (0-3600) wait before re-checking a Page id that was not found
FB_LOGIN_PORT=              # 8765 (1024-65535)
FB_LOGIN_TIMEOUT_MIN=       # 5 (1-30)
FB_MEDIA_DIR=               # media
FB_EXPORT_DIR=              # exports

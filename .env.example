# Copy this file to .env and fill it in yourself. Never paste tokens in chat.
# See docs/SETUP.md for how to get each value.

# One of these two is required.
# Long-lived user token or System User token (recommended: covers all your Pages).
FB_USER_ACCESS_TOKEN=
# Or a single Page token + its Page id.
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Optional: Page ids (comma-separated) to always list, e.g. Pages owned by a Business Portfolio
# that Facebook leaves out of your Page list. Not secret.
FB_EXTRA_PAGE_IDS=

# Recommended: turns on appsecret_proof so a leaked token alone is not enough.
FB_APP_SECRET=
# App ID (not secret). Used by `npm run login`; filled in automatically if blank.
FB_APP_ID=

# Safety switch. Keep false until you have tested reads. true = Claude may post, reply, delete, message.
FB_WRITE_ENABLED=false
FB_MESSENGER_LIVE=            # false. Messenger sending (bot + manual tool). Only true with the owner's OK.

# Tunables (default, min-max). Leave blank to use the default.
FB_GRAPH_VERSION=           # v26.0
FB_READ_RATE_PER_MIN=       # 120 (1-600)
FB_WRITE_RATE_PER_MIN=      # 10 (1-60)
FB_HTTP_TIMEOUT_MS=         # 15000 (1000-60000)
FB_IDEMPOTENCY_TTL_MIN=     # 1440 (1-10080)
FB_MAX_LIST_LIMIT=          # 100 (1-100)
FB_SCHEDULE_MIN_MINUTES=    # 10 (10-1440)
FB_SCHEDULE_MAX_DAYS=       # 30 (1-75)
FB_MAX_UPLOAD_MB=           # 10 (1-100)
FB_LEADS_SCAN_MAX=          # 200 (1-2000) conversations or comments scanned per lead search
FB_LEADS_MESSAGES_PER_CHAT= # 25 (1-100) newest messages read per conversation
FB_LEADS_SCAN_POSTS=        # 25 (1-100) newest posts scanned for comment leads
FB_LEADS_CHATS_PER_PAGE=    # 25 (1-100) conversations fetched per request in Messenger lead search
FB_PAGES_REFRESH_COOLDOWN_SEC= # 60 (0-3600) wait before re-checking a Page id that was not found
FB_LOGIN_PORT=              # 8765 (1024-65535)
FB_LOGIN_TIMEOUT_MIN=       # 5 (1-30)
FB_MEDIA_DIR=               # media
FB_EXPORT_DIR=              # exports

# Messenger application flow (fb_flow_* tools) and the watcher (npm run watch).
FB_FLOW_FILE=               # flow.json  your flow texts (copy flow.example.json); git-ignored
FB_FLOW_DIR=                # exports/flow  where flow state, leads and ID photos are saved (personal data)
FB_PDF_TEMPLATES_DIR=       # pdf-templates  folder with metrobank.pdf, eastwest.pdf, chinabank.pdf (git-ignored)
FB_FLOW_PAGE_ID=            # Page id the watcher handles (required for npm run watch). Not secret.
FB_FLOW_COOLDOWN_DAYS=      # 180 (1-730) days before a person without a credit card may apply again
FB_FLOW_NUDGE_AFTER_HOURS=   # 3 (1-20) one reminder to someone who stopped mid-application, after this many quiet hours (only inside Meta's 24-hour window)
FB_FLOW_REPLY_WINDOW_HOURS= # 23 (1-24) only reply if their last message is newer than this (Meta allows 24h)
FB_FLOW_MESSAGES_PER_CHAT=  # 10 (1-50) newest messages read per chat when checking for new ones
FB_FLOW_MAX_IMAGE_MB=       # 10 (1-25) largest ID photo saved
FB_WATCH_INTERVAL_SEC=      # 10 (3-600) how often the watcher checks for new messages when nobody is chatting
FB_WATCH_ACTIVE_INTERVAL_SEC= # 3 (2-60) how often it checks while someone chatted in the last FB_WATCH_ACTIVE_MINUTES
FB_WATCH_ACTIVE_MINUTES=    # 15 (1-120) how long a chat counts as active
FB_WATCH_CLAUDE_TIMEOUT_MIN= # 5 (1-30) stop a Claude run that takes longer than this
FB_WATCH_CLAUDE_BIN=         # path to the claude program; blank = found automatically
FB_DASHBOARD_PORT=           # 8790 (1024-65535) local dashboard: http://localhost:<port> (this PC only)
# Comment replies as the Page (npm run comments). Off until the owner OKs it.
FB_COMMENTS_LIVE=            # false; true = reply to comments
FB_COMMENT_INTERVAL_SEC=     # 120 (60-3600) how often to check for new comments
FB_COMMENT_MIN_DELAY_SEC=    # 90 (30-3600) wait after a comment before replying (no instant bot replies)
FB_COMMENT_MAX_PER_HOUR=     # 15 (1-60) most replies per hour
FB_COMMENT_MAX_PER_DAY=      # 60 (1-300) most replies per 24 hours (a steady flood of replies looks like spam to Meta)
FB_COMMENT_POST_DAYS=        # 7 (1-30) answer comments on posts up to this old
FB_COMMENT_PRIVATE_REPLY=    # false; true = also DM people who ask how to apply (if they were mid-application, the bot repeats their question)

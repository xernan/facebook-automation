{
  "name": "facebook-automation",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that lets Claude manage Facebook Pages through the official Meta Graph API.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs --all",
    "check": "npm run typecheck && npm test && npm run secret-scan",
    "start": "node dist/server.js",
    "doctor": "node dist/doctor.js",
    "login": "node dist/login.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "name": "facebook-automation",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that lets Claude manage Facebook Pages through the official Meta Graph API.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs --all",
    "check": "npm run typecheck && npm test && npm run secret-scan",
    "start": "node dist/server.js",
    "doctor": "node dist/doctor.js",
    "login": "node dist/login.js",
    "watch": "node dist/watch.js",
    "dashboard": "node dist/dashboard.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^26.6.5",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
